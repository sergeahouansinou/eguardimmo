# Adresse publique du site vitrine (origine sans chemin). Obligatoire en production.
NEXT_PUBLIC_SITE_URL=http://localhost:3070
# Adresses des espaces (origines sans chemin, https en production). Obligatoires en production.
NEXT_PUBLIC_AUTH_URL=http://localhost:3040
NEXT_PUBLIC_AGENCE_URL=http://localhost:3010
NEXT_PUBLIC_PROPRIETAIRE_URL=http://localhost:3020
NEXT_PUBLIC_LOCATAIRE_URL=http://localhost:3030
NEXT_PUBLIC_SEBOOK_URL=http://localhost:3060
# Adresse e-mail de contact affichée sur le site (optionnelle).
NEXT_PUBLIC_CONTACT_EMAIL=
# Tarifs affichés, en JSON, uniquement les montants validés (ADR 0013). Vide : « [À RENSEIGNER] » est affiché.
# Exemple de forme : {"essentiel":{"monthly":"<montant et unité>","yearly":"<montant et unité>"}}
NEXT_PUBLIC_PLAN_PRICES=

# Serveur uniquement (jamais NEXT_PUBLIC_). Sans CONTACT_WEBHOOK_URL, POST /api/contact répond 503 « envoi non configuré ».
# Adresse https du service qui reçoit les demandes ; son nom d'hôte doit figurer dans la liste blanche ci-dessous.
CONTACT_WEBHOOK_URL=
# Noms d'hôtes exacts autorisés pour le webhook, séparés par des virgules.
CONTACT_WEBHOOK_ALLOWED_HOSTS=
