NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_URL=http://localhost:3040
# SeBook n'a pas de mode démonstration : toujours api.
NEXT_PUBLIC_DATA_SOURCE=api
# Origine publique de SeBook (canonique, Open Graph, sitemap). En production : https://sebook.<domaine>
NEXT_PUBLIC_SITE_URL=http://localhost:3060
# Côté serveur seulement, jamais NEXT_PUBLIC_ : même valeur que SEBOOK_RELAY_KEY de l'API, 32 caractères au moins.
# Obligatoire en production ; vide en développement, tous les visiteurs partagent alors la limite anonyme du serveur.
SEBOOK_RELAY_KEY=
