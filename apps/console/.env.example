NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_URL=http://localhost:3040
NEXT_PUBLIC_DATA_SOURCE=demo

# Serveur uniquement, requis seulement avec NEXT_PUBLIC_DATA_SOURCE=api.
# https:// obligatoire en production (http:// admis en local uniquement).
CONSOLE_API_URL=http://localhost:8000
# Générer avec : openssl rand -base64 32
CONSOLE_SESSION_SECRET=remplacer-par-32-octets-en-base64
# Doit rester inférieur ou égal à CONSOLE_TOKEN_TTL_MINUTES du backend (240 par défaut).
CONSOLE_TOKEN_TTL_MINUTES=240
# Même valeur que CONSOLE_RELAY_KEY du backend : php -r "echo base64_encode(random_bytes(32));"
CONSOLE_RELAY_KEY=remplacer-par-la-cle-de-relais-du-backend
# Origine publique de la console (schéma + hôte [+ port], sans chemin). Obligatoire en production et en https :
# l'Origin des écritures (connexion, déconnexion, relais) est comparée à cette valeur, jamais aux en-têtes Host ou X-Forwarded-*.
# Facultative en local : sans elle, l'hôte de la requête fait foi.
CONSOLE_PUBLIC_ORIGIN=http://localhost:3050
# Topologie de proxys attendue : navigateur -> [CDN ou répartiteur] -> console, chaque maillon ajoutant son adresse source à la fin de
# X-Forwarded-For. La valeur est le nombre de ces maillons de confiance (1 par défaut : un seul proxy devant la console) ;
# l'adresse retenue est la n-ième en partant de la fin, ce qui ignore tout ce qu'un client a pu écrire en tête de l'en-tête.
# Une valeur trop grande retient une adresse fournie par le client (contournement de la limitation de débit côté API), une valeur
# trop petite retient l'adresse d'un proxy. Sans proxy devant la console, X-Forwarded-For doit être supprimé par l'infrastructure.
CONSOLE_TRUSTED_PROXY_HOPS=1
