APP_NAME=eGuardImmo
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.eguardimmo.test
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Sécurité API (voir docs/adr/0002)
CORS_ALLOWED_ORIGINS=http://auth.eguardimmo.test:3001,http://locataire.eguardimmo.test:3002,http://proprietaire.eguardimmo.test:3003,http://agence.eguardimmo.test:3000,http://sebook.eguardimmo.test:3004
SANCTUM_STATEFUL_DOMAINS=auth.eguardimmo.test:3001,locataire.eguardimmo.test:3002,proprietaire.eguardimmo.test:3003,agence.eguardimmo.test:3000,sebook.eguardimmo.test:3004
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
TRUSTED_PROXIES=

# Authentification centralisée (voir docs/adr/0004)
AUTH_HUB_URL=http://auth.eguardimmo.test:3001
AUTH_RETURN_TO_ALLOWED_HOSTS=auth.eguardimmo.test,locataire.eguardimmo.test,proprietaire.eguardimmo.test,agence.eguardimmo.test,sebook.eguardimmo.test
SESSION_ABSOLUTE_MINUTES=720
OPERATOR_SESSION_ABSOLUTE_MINUTES=60
CONSOLE_TOKEN_TTL_MINUTES=240
# Clé partagée avec le serveur de la console : sans elle ou si elle fait moins de 32 caractères, l'IP transmise par la console est ignorée. php -r "echo base64_encode(random_bytes(32));"
CONSOLE_RELAY_KEY=
REAUTHENTICATION_MINUTES=10
AUTH_PASSWORD_TIMEOUT=600
# Clé dédiée au HMAC des e-mails journalisés : php -r "echo base64_encode(random_bytes(32));"
AUDIT_HMAC_KEY=
# Clé dédiée aux empreintes des identifiants et IBAN des parties (unicité, recherche) : php -r "echo base64_encode(random_bytes(32));"
PARTIES_HMAC_KEY=
# Clé dédiée aux empreintes des IBAN de l'organisation et des contreparties, et aux clés de dédoublonnage des relevés bancaires (ADR 0035) : php -r "echo base64_encode(random_bytes(32));"
BANKING_HMAC_KEY=
# Relevés bancaires : taille (octets) et nombre de lignes maximaux d'un fichier, fenêtre de proposition d'une écriture existante (jours avant la comptabilisation)
BANKING_IMPORT_MAX_BYTES=10485760
BANKING_IMPORT_MAX_LINES=20000
BANKING_MATCH_WINDOW_DAYS=15
# Conservation comptable du fichier de relevé (années), à confirmer avec l'expert-comptable
BANKING_RETENTION_YEARS=10
# Dossier des schémas XSD officiels ISO 20022 camt.053 (camt.053.001.02.xsd et camt.053.001.08.xsd, à télécharger sur iso20022.org). Tant qu'ils manquent et que BANKING_XSD_REQUIRED=true (défaut), l'import camt.053 est refusé (503 banking_xsd_unavailable) ; le CSV reste disponible
BANKING_XSD_DIRECTORY=
BANKING_XSD_REQUIRED=true
# Clôture mensuelle d'une agence qui détient des fonds de tiers : un compte de tiers suivi (rôle trust_bank) est exigé tant que la valeur est true
BANKING_REQUIRE_TRUST_ACCOUNT=true

# Google (console Google Cloud : un identifiant web, un iOS, un Android)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_IDS_MOBILE=

# Apple (Apple Developer) : la clé .p8 reste hors dépôt, en 0400, hors docroot
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_SERVICES_ID=
APPLE_BUNDLE_ID=

# Gotenberg (service HTTP de rendu PDF des avis d'échéance et quittances, module Rent) : jamais de PDF produit en PHP
RENT_GOTENBERG_URL=http://localhost:3000
RENT_GOTENBERG_TIMEOUT=20
RECOVERY_GOTENBERG_URL=
# Factures et avoirs (module Invoicing) : vide = repli sur RENT_GOTENBERG_URL
INVOICING_GOTENBERG_URL=
# Le rendu se fait sous le verrou du compteur de numéros : le délai est borné à 15 s par le code (ADR 0028)
INVOICING_GOTENBERG_TIMEOUT=15
# Comptes rendus de gestion (module Reporting) : vide = repli sur RENT_GOTENBERG_URL ; le délai est borné à 15 s par le code (publication sous verrou, ADR 0030)
REPORTING_GOTENBERG_URL=
REPORTING_GOTENBERG_TIMEOUT=15
# Lettres de congé du locataire (module Leases) : vide = repli sur RENT_GOTENBERG_URL ; délai borné à 15 s (émission sous verrou, ADR 0036)
LEASES_GOTENBERG_URL=
LEASES_GOTENBERG_TIMEOUT=15
# Jours ouvrés sans accusé de réception d'une demande de congé avant d'alerter l'agence et le locataire (ADR 0036)
TENANT_NOTICE_ACK_BUSINESS_DAYS=2
# Décomptes de régularisation des charges (module Charges) : vide = repli sur RENT_GOTENBERG_URL ; le délai est borné à 15 s par le code (émission sous verrou, ADR 0034)
CHARGES_GOTENBERG_URL=
CHARGES_GOTENBERG_TIMEOUT=15
# Dépense réglée sur les fonds du mandant : au-delà de ce montant (unités mineures, à fixer avec l'expert-comptable), une seconde personne habilitée valide
CHARGES_THIRD_PARTY_SECOND_APPROVAL_MINOR=100000
# Mois après la fin d'un exercice au-delà desquels charges:flag-due signale un bail sans décompte émis
CHARGES_DUE_AFTER_MONTHS=9
CHARGES_ACCOUNTING_RETENTION_YEARS=10
CHARGES_EXPORT_MAX_ROWS=50000
# Envois d'une facture par e-mail : plafonds par heure, par facture et par organisation
INVOICING_SEND_PER_INVOICE_PER_HOUR=3
INVOICING_SEND_PER_ORGANIZATION_PER_HOUR=60
# Date d'entrée de l'obligation de facture électronique entre assujettis en France (à confirmer)
INVOICING_EINVOICING_FR_FROM=2027-09-01
RECOVERY_LINK_URL=
RECOVERY_DOWNLOAD_PER_MINUTE=5
RECOVERY_GENERATION_PER_MINUTE=6

# Notifications (ADR 0027) : bases https des applications pour les liens des e-mails ; push désactivé tant que le pilote vaut none
NOTIFICATIONS_ORGANIZATION_URL=
NOTIFICATIONS_TENANT_URL=
NOTIFICATIONS_OWNER_URL=
NOTIFICATIONS_PUSH_DRIVER=none
NOTIFICATIONS_PUSH_PER_HOUR=20
NOTIFICATIONS_FCM_PROJECT_ID=
NOTIFICATIONS_FCM_CREDENTIALS=
NOTIFICATIONS_FCM_TIMEOUT=5

# Documents : nombre maximal de pixels d'une image réencodée (mémoire GD, ~4 octets par pixel)
DOCUMENTS_IMAGE_MAX_PIXELS=25000000
# Antivirus des pièces déposées : none (développement), clamd (production), fake (tests). Une pièce non vérifiable reste bloquée.
DOCUMENTS_MALWARE_SCANNER=none
DOCUMENTS_CLAMD_SOCKET=unix:///var/run/clamav/clamd.ctl
DOCUMENTS_CLAMD_TIMEOUT=15
DOCUMENTS_UNVERIFIABLE_ALERT_THRESHOLD=20

# Maintenance (ADR 0029) : délai de réponse du mandant (24 à 168 h), tolérance d'arrondi de TVA par taux (unités mineures, à confirmer), plafonds d'abus
MAINTENANCE_APPROVAL_DEADLINE_HOURS=48
MAINTENANCE_INVOICE_TAX_TOLERANCE_MINOR=5
MAINTENANCE_EMERGENCY_CEILING_MINOR=200000
MAINTENANCE_MAX_OPEN_PER_LEASE=10
MAINTENANCE_FILES_PER_INTERVENTION=30
MAINTENANCE_PHOTOS_PER_REPORT=6
MAINTENANCE_TENANT_MEDIA_RETENTION_YEARS=5
MAINTENANCE_ACCOUNTING_RETENTION_YEARS=10
# Version du texte de mention affiché au mandant quand il décide sur un devis (ADR 0032) : le client la renvoie, une version périmée est refusée
MAINTENANCE_OWNER_DECISION_STATEMENT_VERSION=v1
MAINTENANCE_THIRD_PARTY_SECOND_APPROVAL_MINOR=100000

OWNER_FUNDS_BATCH_MAX=50
OWNER_FUNDS_PREVIEW_LIMIT=20
OWNER_FUNDS_PAYOUT_MINIMUM_MINOR=0
OWNER_FUNDS_REQUIRE_SECOND_APPROVER=true
OWNER_FUNDS_ACCOUNT_COOLING_DAYS=2
OWNER_FUNDS_PENDING_WARNING_DAYS=10
OWNER_PAYOUT_REQUEST_DAYS=14
OWNER_FUNDS_PAYOUT_CODE_MINUTES=15
OWNER_FUNDS_PAYOUT_CODE_ATTEMPTS=3
OWNER_FUNDS_PAYOUT_PROOF_RETENTION_YEARS=10
# Comptes rendus de gestion (module Reporting, ADR 0030) : mandants par demande de création, lignes d'un export CSV
REPORTING_BATCH_MAX=50
REPORTING_EXPORT_MAX_ROWS=50000
# Espace propriétaire (ADR 0032, lot 1) : validité d'une invitation en jours, accès vivants maximum par mandant (accès et invitations en attente)
OWNER_INVITATION_DAYS=7
# Invitations (propriétaire, locataire) émises par une organisation sur vingt-quatre heures : chacune envoie un e-mail sous le nom de la plateforme
OWNER_INVITATION_DAILY_MAX=100
TENANT_INVITATION_DAILY_MAX=100
OWNER_ACCESS_MAX_PER_MANDANT=5

# Support de la plateforme (ADR 0033, lot 3) : horaires servis par GET /support/status. Format : jours ISO (1 = lundi) puis plage, fenêtres séparées par « ; » (ex. « 1-5 09:00-18:00 »)
SUPPORT_HOURS="1-5 09:00-18:00"
SUPPORT_TIMEZONE=Europe/Paris
SUPPORT_RESPONSE_LABEL="Réponse sous 1 jour ouvré"
# Délai (heures) pendant lequel aucun accès d'urgence du support n'est ouvert sur une organisation après qu'elle en a révoqué un
SUPPORT_EMERGENCY_COOLDOWN_HOURS=24
# Base https de l'application où mène le lien d'une notification de compte (réponse du support) : sans base valide, l'e-mail part sans lien
NOTIFICATIONS_ACCOUNT_URL=

# Diffusions (ADR 0033, lot 5) : vide, aucun e-mail de diffusion ne part (brouillons, validation et programmation restent possibles). Valeur admise : mailtrap
# Mise en production conditionnée à : DPA signé, mécanisme de transfert hors UE établi, localisation confirmée par écrit auprès du fournisseur
MAIL_PROVIDER=
# Flux transactionnel (notifications) : MAIL_MAILER=mailtrap_transactional ; flux Bulk (diffusions) : mailer ci-dessous. Deux sous-domaines d'envoi
MAILTRAP_TRANSACTIONAL_HOST=live.smtp.mailtrap.io
MAILTRAP_TRANSACTIONAL_PORT=587
MAILTRAP_TRANSACTIONAL_USERNAME=api
MAILTRAP_TRANSACTIONAL_PASSWORD=
MAILTRAP_BULK_HOST=bulk.smtp.mailtrap.io
MAILTRAP_BULK_PORT=587
MAILTRAP_BULK_USERNAME=api
MAILTRAP_BULK_PASSWORD=
MAIL_BULK_MAILER=mailtrap_bulk
# Adresse d'expédition des diffusions (sous-domaine dédié, SPF, DKIM et DMARC alignés)
DIFFUSION_FROM_ADDRESS=
# Clé HMAC des liens de désinscription : php -r "echo base64_encode(random_bytes(32));"
MAIL_UNSUBSCRIBE_KEY=
MAIL_UNSUBSCRIBE_TTL_DAYS=400
# Secret de signature du webhook POST /api/v1/webhooks/mail/mailtrap (en-tête Mailtrap-Signature)
MAIL_WEBHOOK_SECRET_MAILTRAP=
# Plafonds par organisation : destinataires sur 24 heures, envois par heure, envois de test par heure et par compte
CAMPAIGN_DAILY_RECIPIENTS=2000
CAMPAIGN_HOURLY_SENDS=10
CAMPAIGN_HOURLY_TESTS=5
# Campagnes de la plateforme (ADR 0042) : destinataires par campagne au plus (au-delà, l'envoi est refusé), rappels créés par exécution au plus
MARKETING_MAX_RECIPIENTS=20000
REMINDERS_MAX_PER_RUN=2000

# Paiement en ligne (module Payments, ADR 0036) : `none` (défaut) = désactivé, `fake` = PSP simulé (développement et tests seulement : refusé au démarrage en production)
PAYMENTS_GATEWAY=fake
PAYMENTS_FAKE_WEBHOOK_SECRET=
# Après le choix du PSP (Stripe Connect prévu, non branché) : clés du fournisseur retenu
PAYMENTS_STRIPE_SECRET_KEY=
PAYMENTS_STRIPE_WEBHOOK_SECRET=
# Page de retour du locataire après la page de paiement hébergée par le PSP ; en production, https:// obligatoire
PAYMENTS_RETURN_URL=http://locataire.eguardimmo.test:3002/paiement/retour

# Console d'administration (ADR 0037) : boîte d'équipe prévenue (sans contenu) d'une demande de double validation en attente
CONSOLE_TEAM_ADDRESS=
# Liens affichés par la console : supervision externe et page de statut externe (l'application ne les héberge pas)
CONSOLE_MONITORING_URL=
CONSOLE_STATUS_PAGE_URL=
# Double validation : durée de vie d'une demande (heures)
OPERATIONS_APPROVAL_TTL_HOURS=24
# Santé : une sauvegarde réussie plus ancienne que cette durée (heures) est signalée
OPERATIONS_BACKUP_MAX_AGE_HOURS=26
# Santé : retard (secondes) de la plus ancienne tâche en file au-delà duquel la file est signalée (pilote database)
OPERATIONS_QUEUE_MAX_AGE_SECONDS=900
# Santé : base de Gotenberg ; vide, RENT_GOTENBERG_URL est reprise
OPERATIONS_GOTENBERG_URL=
# Export RGPD du compte : durée de téléchargement (jours)
PRIVACY_EXPORT_TTL_DAYS=30
# Boîte de l'équipe du support (demandes d'assistance, ADR 0033)
SUPPORT_TEAM_ADDRESS=

# Journal d'activité de l'organisation (ADR 0038) : mois affichés et plafond de lignes d'un export CSV
ORGANIZATIONS_ACTIVITY_RETENTION_MONTHS=12
ORGANIZATIONS_ACTIVITY_EXPORT_MAX_ROWS=50000

# Organisations qu'un même compte peut créer (donc posséder)
ORGANIZATIONS_MAX_OWNED_PER_USER=5

# Invitations de membres : e-mails au plus par organisation (heure, 24 h), par adresse invitée (24 h), délai entre deux renvois (secondes) et renvois au plus par invitation (24 h)
ORGANIZATIONS_INVITATION_ORGANIZATION_HOURLY_MAX=30
ORGANIZATIONS_INVITATION_ORGANIZATION_DAILY_MAX=100
ORGANIZATIONS_INVITATION_ADDRESS_DAILY_MAX=3
ORGANIZATIONS_INVITATION_RESEND_DELAY_SECONDS=60
ORGANIZATIONS_INVITATION_RESEND_DAILY_MAX=3

# Agenda (ADR 0038) : séries récurrentes actives au plus par organisation
PLANNING_MAX_ACTIVE_SERIES=200

INVESTMENTS_IMPORT_MAX_LINES=600
INVESTMENTS_RETENTION_YEARS=10
TAX_GOTENBERG_URL=
TAX_GOTENBERG_TIMEOUT=15
TAX_RETENTION_YEARS=6
TAX_STATEMENTS_MAX_MANDANTS=10
TAX_STATEMENTS_TIME_BUDGET_SECONDS=90

# SeBook : frais de service en centièmes de pour cent (150 = 1,5 %). [À RENSEIGNER] 0 tant que le tarif n'est pas arrêté (ADR 0013 et 0041).
MARKETPLACE_SERVICE_FEE_BASIS_POINTS=0
MARKETPLACE_TIMEZONE=Europe/Paris
MARKETPLACE_DEMO_ORGANIZATION=
# Clé partagée avec le serveur de SeBook (même valeur dans apps/sebook) : sans elle ou si elle fait moins de 32 caractères, tous les visiteurs de SeBook partagent la limite anonyme de son serveur. php -r "echo base64_encode(random_bytes(32));"
SEBOOK_RELAY_KEY=
