APP_NAME=eGuardImmo
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://api.__DOMAIN__
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_DATABASE=eguardimmo
DB_USERNAME=eg_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_DOMAIN=.__DOMAIN__
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

CORS_ALLOWED_ORIGINS=https://auth.__DOMAIN__,https://locataire.__DOMAIN__,https://proprietaire.__DOMAIN__,https://agence.__DOMAIN__,https://sebook.__DOMAIN__
SANCTUM_STATEFUL_DOMAINS=auth.__DOMAIN__,locataire.__DOMAIN__,proprietaire.__DOMAIN__,agence.__DOMAIN__,sebook.__DOMAIN__
AUTH_HUB_URL=https://auth.__DOMAIN__
AUTH_RETURN_TO_ALLOWED_HOSTS=auth.__DOMAIN__,locataire.__DOMAIN__,proprietaire.__DOMAIN__,agence.__DOMAIN__,sebook.__DOMAIN__
# Vide tant que Nginx est le seul intermédiaire ; avec un CDN ou un répartiteur, y mettre ses adresses.
TRUSTED_PROXIES=

AUDIT_HMAC_KEY=
PARTIES_HMAC_KEY=
BANKING_HMAC_KEY=
MAIL_UNSUBSCRIBE_KEY=
CONSOLE_RELAY_KEY=

MAIL_MAILER=mailtrap_transactional
MAILTRAP_TRANSACTIONAL_PASSWORD=
MAIL_FROM_ADDRESS=ne-pas-repondre@__DOMAIN__
MAIL_FROM_NAME="${APP_NAME}"
# Diffusions : laisser MAIL_PROVIDER vide tant que le flux Bulk n'est pas configuré (valeur : mailtrap).
MAIL_PROVIDER=
MAILTRAP_BULK_PASSWORD=
DIFFUSION_FROM_ADDRESS=
MAIL_WEBHOOK_SECRET_MAILTRAP=

NOTIFICATIONS_ORGANIZATION_URL=https://agence.__DOMAIN__
NOTIFICATIONS_TENANT_URL=https://locataire.__DOMAIN__
NOTIFICATIONS_OWNER_URL=https://proprietaire.__DOMAIN__
# Vide : les e-mails de compte partent sans lien plutôt qu'avec un lien cassé.
NOTIFICATIONS_ACCOUNT_URL=
CONSOLE_TEAM_ADDRESS=
SUPPORT_TEAM_ADDRESS=

DOCUMENTS_MALWARE_SCANNER=clamd
DOCUMENTS_CLAMD_SOCKET=unix:///var/run/clamav/clamd.ctl
RENT_GOTENBERG_URL=http://127.0.0.1:3000

PAYMENTS_GATEWAY=none
PAYMENTS_RETURN_URL=https://locataire.__DOMAIN__/paiement/retour

# Les schémas XSD sont exigés par défaut pour les relevés bancaires XML.
BANKING_XSD_DIRECTORY=
